# Copy to .env in this directory (do not commit .env)

# OpenAI (required)
OPENAI_API_KEY=your_openai_api_key_here

# LangSmith tracing (optional — agent runs appear at https://smith.langchain.com/)
LANGSMITH_API_KEY=lsv2_pt_your_api_key_here
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=invoice-context-demo
